# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/payflow
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Email (optional). If left empty, PayFlow logs emails to the console instead
# of sending them, so the app still runs locally without crashing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=PayFlow <no-reply@payflow.local>

# First admin account created automatically on first startup (optional).
# Leave ADMIN_EMAIL empty to skip seeding. Change the password after login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
